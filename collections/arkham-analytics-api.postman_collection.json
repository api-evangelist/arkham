        {
          "id": "53c67a0e-83eb-430a-afdb-e7b3030caa0c",
          "name": "Get API endpoint call analytics",
          "request": {
            "name": "Get API endpoint call analytics",
            "description": {
              "content": "Returns your API usage broken down by endpoint, including call counts and credits consumed.\n\nIf your API key belongs to an organization member, results are scoped to your usage within that org. Otherwise, results cover your individual subscription usage.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "analytics",
                "endpoint-calls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Time window: \"24h\", \"7d\", or \"30d\". Defaults to \"24h\". Ignored when both start_date and end_date are provided."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "RFC3339 timestamp. Historical cutoff for the period-based window, or the upper bound of a custom range."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "RFC3339 timestamp. Lower bound of a custom date range. Only takes effect together with end_date — a custom range requires both; start_date supplied on its own is ignored. Max range 366 days."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
