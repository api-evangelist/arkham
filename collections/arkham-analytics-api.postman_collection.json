          "id": "ed13222b-0c98-4b1d-8086-f0479b6dc2cf",
          "name": "Get historical credit usage by billing period",
          "request": {
            "name": "Get historical credit usage by billing period",
            "description": {
              "content": "Returns the last 12 billing periods of credit usage for your billing entity.\n\nEach period includes the period boundaries, plan credits included, extra (overage) credits, and total credits consumed.\n\nOnly available to organization admins (returning their org's usage) and individual API subscribers (returning their own usage). Other callers receive `403`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "analytics",
                "credit-periods"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
