          "name": "Get current status for all blockchain networks",
          "request": {
            "name": "Get current status for all blockchain networks",
            "description": {
              "content": "Retrieves the current status for all supported blockchain networks, including price, 24h price change, volume, market cap, latest block (tip), total transfers, and gas/fee information. Each network includes an \"asOf\" object giving the time each piece of data was last read; values are served from a cache refreshed about once per minute.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "networks",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
