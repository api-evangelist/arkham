          "name": "Get cluster summary statistics",
          "request": {
            "name": "Get cluster summary statistics",
            "description": {
              "content": "Returns summary statistics for the specified cluster, including:\n- Total number of unique addresses in the cluster\n- Total balance in USD\n- Total transaction volume in USD\n- First and last transaction timestamps\n\nClusters are groups of addresses that have been linked together through on-chain heuristics (e.g., Bitcoin input clustering).\n\nTo find a cluster ID, look up an address with GET /intelligence/address_enriched/{address} and read its clusterIds field.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cluster",
                ":id",
                "summary"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the cluster to summarize."
                }
              ]
            },
